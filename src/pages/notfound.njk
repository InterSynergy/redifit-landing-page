---
pageKey: notfound
---
<main class="notfound-main">
    <div class="container-narrow">
        <div class="notfound-logo">
            <img class="logo-mark" style="height:40px;" src="{% asset "assets/logo.webp" %}" alt="{% ta "notfound.main.logo_mark_alt" %}" />
        </div>
        <h1>{% t "notfound.main.h1" %}</h1>
        <p>{% t "notfound.main.p" %}</p>
        <a href="{% url "home" %}" class="btn btn-primary">{% t "notfound.main.btn" %}</a>
    </div>
</main>
<section id="pobierz" class="cta-banner" style="padding:64px 24px;">
    <div class="container">
        <h2 style="font-size:clamp(22px,2.8vw,32px);">{% t "notfound.pobierz.h2" %}</h2>
        <p>{% t "notfound.pobierz.p" %}</p>
        <div class="hero__cta-row">
            <span class="btn btn-lg btn-on-red">{% t "notfound.pobierz.btn" %}</span>
            <div class="store-badges">
                <img src="{% asset "assets/google-play.png" %}" alt="{% ta "notfound.pobierz.img_alt" %}" title="{% ta "notfound.pobierz.img_title" %}" />
                <img src="{% asset "assets/app-store.svg" %}" alt="{% ta "notfound.pobierz.img_alt_2" %}" title="{% ta "notfound.pobierz.img_title_2" %}" />
            </div>
        </div>
    </div>
</section>
