---
pageKey: home
css: [home]
---
{# Strona główna (klient). Numery #N w komentarzach = punkty z uwag klienta, docs/landing-zadania.md #}
<main>
    {# #1–#10 #}
    <section id="hero" class="hero">
        <div class="hero__pattern" aria-hidden="true"></div>
        <div class="hero__grid">
            <div class="hero__copy">
                <div class="role-toggle">
                    <span aria-current="page">{% t "home.hero.role_client" %}</span>
                    <a href="{% url "trainers" %}">{% t "home.hero.role_trainer" %}</a>
                </div>
                <p class="hero__eyebrow">{% t "home.hero.eyebrow" %}</p>
                <h1 class="h1">{% t "home.hero.h1" %}</h1>
                <p class="hero__sub">{% t "home.hero.sub" %}</p>
                <p class="hero__free">{% t "home.hero.free" %}</p>
                <div class="hero__cta-row">
                    {% include "partials/store-row.njk" %}
                </div>
                <div class="hero__tagline">
                    <p class="hero__tagline-title">{% t "home.hero.tagline_title" %}</p>
                    <p class="hero__tagline-text">{% t "home.hero.tagline_text" %}</p>
                </div>
                <a href="{% url "trainers" %}" class="hero__switch-link">{% t "home.hero.switch_link" %}</a>
            </div>
            <div class="hero__media">
                {# #3: screen H1 — ekran główny aplikacji (wyszukiwarka + kategorie) #}
                <figure class="phone phone--tilt-l">
                    <div class="phone__screen phone__screen--shot">
                        <img src="{% asset "assets/screens/H1_" + lang.code + ".webp" %}" alt="{% ta "home.hero.screen_caption" %}" width="720" height="1473" fetchpriority="high" decoding="async">
                    </div>
                </figure>
            </div>
        </div>
        {# #8: pasek statystyk ukryty do czasu realnych danych — włącza site.json → features.stats #}
        {% if site.features.stats %}
        <div class="proof-bar">
            <div class="proof-bar__grid">
                {%- for key in ['trainers', 'cities', 'categories', 'rating'] %}
                <div class="proof-stat">
                    <p class="proof-stat__value">{% t "home.hero.stats." + key + "_value" %}</p>
                    <p class="proof-stat__label">{% t "home.hero.stats." + key + "_label" %}</p>
                </div>
                {%- endfor %}
            </div>
        </div>
        {% endif %}
    </section>

    {# #11–#12 #}
    <section id="dlaczego" class="section">
        <div class="container">
            <h2 class="h2">{% t "home.dlaczego.h2" %}</h2>
            <div class="compare-grid compare-grid--lg">
                <div class="compare-card compare-card--without">
                    <p class="compare-card__title">{% t "home.dlaczego.without_title" %}</p>
                    <ul>
                        {%- for i in range(1, 6) %}
                        <li><span>{% t "home.dlaczego.without_" + i %}</span></li>
                        {%- endfor %}
                    </ul>
                </div>
                <div class="compare-card compare-card--with">
                    <p class="compare-card__title">{% t "home.dlaczego.with_title" %}</p>
                    <ul>
                        {%- for i in range(1, 6) %}
                        <li><span>{% t "home.dlaczego.with_" + i %}</span></li>
                        {%- endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </section>

    {# #13–#16 #}
    <section id="kroki" class="section section-alt">
        <div class="container">
            <div class="intro">
                <h2 class="h2">{% t "home.kroki.h2" %}</h2>
                <p class="lead">{% t "home.kroki.lead" %}</p>
            </div>
            <ol class="step-card-grid">
                {%- for i in range(1, 4) %}
                <li class="step-card">
                    <p class="step-card__step"><span class="step-card__word">{% t "home.kroki.step_label" %}</span> <span class="step-card__num">{{ i }}</span></p>
                    <h3>{% t "home.kroki.step_" + i + "_title" %}</h3>
                    <p>{% t "home.kroki.step_" + i + "_text" %}</p>
                </li>
                {%- endfor %}
            </ol>
            <a href="{% url "find" %}" class="btn btn-outline">{% t "home.kroki.cta" %}</a>
        </div>
    </section>

    {# #17–#18: karuzela kategorii; lista i zdjęcia w site.json → categories #}
    <section id="kategorie" class="section">
        <div class="container">
            <div class="intro">
                <h2 class="h2">{% t "home.kategorie.h2" %}</h2>
                <p class="lead">{% t "home.kategorie.lead" %}</p>
            </div>
            <div class="cat-carousel" data-carousel>
                <button type="button" class="cat-carousel__nav cat-carousel__nav--prev" data-carousel-prev aria-label="{% ta 'home.kategorie.prev' %}">‹</button>
                <ul class="cat-track" data-carousel-track aria-label="{% ta 'home.kategorie.carousel_label' %}">
                    {%- for c in site.categories %}
                    <li class="cat-item">
                        {%- if c.image %}
                        <img class="cat-item__img" src="{% asset c.image %}" alt="" loading="lazy">
                        {%- else %}
                        <span class="cat-item__img cat-item__img--empty" aria-hidden="true"></span>
                        {%- endif %}
                        <span class="cat-item__name">{% t "home.kategorie.items." + c.id %}</span>
                    </li>
                    {%- endfor %}
                    <li class="cat-item cat-item--more">
                        <a class="cat-item__img" href="{% url "find" %}">{% t "home.kategorie.more" %}</a>
                    </li>
                </ul>
                <button type="button" class="cat-carousel__nav cat-carousel__nav--next" data-carousel-next aria-label="{% ta 'home.kategorie.next' %}">›</button>
            </div>
        </div>
    </section>

    {# #19–#20 #}
    <section id="gdzie" class="section section-alt">
        <div class="container">
            <div class="intro">
                <h2 class="h2">{% t "home.gdzie.h2" %}</h2>
                <p class="lead">{% t "home.gdzie.lead" %}</p>
            </div>
            {%- for key in ['onsite', 'mobile', 'nearby'] %}
            <div class="feature-card">
                <p class="kicker">{% t "home.gdzie." + key + "_kicker" %}</p>
                <h3>{% t "home.gdzie." + key + "_title" %}</h3>
                <p>{% t "home.gdzie." + key + "_text" %}</p>
            </div>
            {%- endfor %}
        </div>
    </section>

    {# #21–#22 #}
    <section id="wydarzenia" class="section step-section">
        <div class="container">
            <div class="step-section__copy">
                <p class="eyebrow">{% t "home.wydarzenia.eyebrow" %}</p>
                <h2 class="h2">{% t "home.wydarzenia.h2" %}</h2>
                <p class="lead">{% t "home.wydarzenia.lead" %}</p>
                <ul class="step-list">
                    {%- for key in ['events', 'happy', 'today', 'favs'] %}
                    <li><span><strong>{% t "home.wydarzenia." + key + "_title" %}</strong> {% t "home.wydarzenia." + key + "_text" %}</span></li>
                    {%- endfor %}
                </ul>
            </div>
            {# #22: H2 (Trenuj dziś) + X2 (szczegóły wydarzenia) #}
            <div class="phone-row">
                <figure class="phone phone--sm">
                    <div class="phone__screen phone__screen--shot">
                        <img src="{% asset "assets/screens/H2_" + lang.code + ".webp" %}" alt="{% ta "home.wydarzenia.screen_caption" %}" width="720" height="1473" loading="lazy" decoding="async">
                    </div>
                </figure>
                <figure class="phone phone--sm phone--raised">
                    <div class="phone__screen phone__screen--shot">
                        <img src="{% asset "assets/screens/X2_" + lang.code + ".webp" %}" alt="{% ta "home.wydarzenia.screen_2" %}" width="720" height="1473" loading="lazy" decoding="async">
                    </div>
                </figure>
            </div>
        </div>
    </section>

    {# #23: kafelki z prawdziwymi opiniami dojdą, gdy pojawią się w aplikacji #}
    <section id="opinie" class="section section-alt step-section">
        <div class="container">
            <div class="hero__media">
                <figure class="phone">
                    <div class="phone__screen phone__screen--shot">
                        <img src="{% asset "assets/screens/H3_" + lang.code + ".webp" %}" alt="{% ta "home.opinie.screen_caption" %}" width="720" height="1473" loading="lazy" decoding="async">
                    </div>
                </figure>
            </div>
            <div class="step-section__copy">
                <p class="eyebrow">{% t "home.opinie.eyebrow" %}</p>
                <h2 class="h2">{% t "home.opinie.h2" %}</h2>
                <p class="lead">{% t "home.opinie.lead" %}</p>
            </div>
        </div>
    </section>

    {# #24: screen X1 — wybór języka w aplikacji (zamiast grafiki wg docs/wzory/24-jezyk-dropdown.png) #}
    <section id="jezyki">
        <div class="container">
            <div class="intro">
                <h2>{% t "home.jezyki.h2" %}</h2>
                <p class="lead">{% t "home.jezyki.lead" %}</p>
            </div>
            <figure class="phone phone--sm">
                <div class="phone__screen phone__screen--shot">
                    <img src="{% asset "assets/screens/X1_" + lang.code + ".webp" %}" alt="{% ta "home.jezyki.screen_caption" %}" width="720" height="1473" loading="lazy" decoding="async">
                </div>
            </figure>
        </div>
    </section>

    {# #25 #}
    <section id="sciezki" class="section">
        <div class="container">
            <div class="intro">
                <h2 class="h2">{% t "home.sciezki.h2" %}</h2>
                <p class="lead">{% t "home.sciezki.lead" %}</p>
            </div>
            <div class="path-grid">
                <div class="path-card path-card--client">
                    <p class="path-card__label">{% t "home.sciezki.client_label" %}</p>
                    <h3>{% t "home.sciezki.client_title" %}</h3>
                    <ul>
                        {%- for i in range(1, 6) %}
                        <li>{% t "home.sciezki.client_" + i %}</li>
                        {%- endfor %}
                    </ul>
                    <p class="path-card__free">{% t "home.sciezki.client_free" %}</p>
                    <a href="{% url "find" %}" class="btn-ghost-link">{% t "home.sciezki.client_link" %}</a>
                </div>
                <div class="path-card path-card--trainer">
                    <p class="path-card__label">{% t "home.sciezki.trainer_label" %}</p>
                    <h3>{% t "home.sciezki.trainer_title" %}</h3>
                    <ul>
                        {%- for i in range(1, 6) %}
                        <li>{% t "home.sciezki.trainer_" + i %}</li>
                        {%- endfor %}
                    </ul>
                    <a href="{% url "trainers" %}" class="btn-ghost-link">{% t "home.sciezki.trainer_link" %}</a>
                </div>
            </div>
        </div>
    </section>

    {# #26 #}
    <section id="pobierz" class="cta-banner">
        <div class="container">
            <h2>{% t "home.pobierz.h2" %}</h2>
            <p>{% t "home.pobierz.p" %}</p>
            <div class="hero__cta-row">
                {% include "partials/store-row.njk" %}
            </div>
            <div class="hero__cta-row">
                <p class="hero__note">{% t "home.pobierz.note" %}</p>
                <a href="{% url "faq" %}" class="hero__switch-link">{% t "home.pobierz.faq_link" %}</a>
            </div>
        </div>
    </section>
</main>
