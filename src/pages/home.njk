---
pageKey: home
css: [home]
---
<main>
    <section id="hero" class="hero">
        <div class="hero__pattern" aria-hidden="true"></div>
        <div class="hero__scrim" aria-hidden="true"></div>
        <p class="hero__needs">{% t "home.hero.needs" %}</p>
        <div class="hero__grid">
            <div class="hero__copy">
                <div class="role-toggle">
                    <span aria-current="page">{% t "home.hero.span" %}</span>
                    <a href="{% url "trainers" %}">{% t "home.hero.a" %}</a>
                </div>
                <p class="hero__eyebrow">{% t "home.hero.eyebrow" %}</p>
                <h1 class="h1">{% t "home.hero.h1" %}</h1>
                <p class="hero__sub">{% t "home.hero.sub" %}</p>
                <div class="hero__cta-row">
                    <a href="#pobierz" class="btn btn-lg btn-primary">{% t "home.hero.btn" %}</a>
                    <div class="store-badges">
                        <img src="{% asset "assets/google-play.png" %}" alt="{% ta "home.hero.img_alt" %}" title="{% ta "home.hero.img_title" %}" />
                        <img src="{% asset "assets/app-store.svg" %}" alt="{% ta "home.hero.img_alt_2" %}" title="{% ta "home.hero.img_title_2" %}" />
                    </div>
                    <div class="qr-mock">
                        <span class="qr-mock__box" aria-hidden="true"></span>
                        <span class="qr-mock__caption">{% t "home.hero.caption" %}</span>
                    </div>
                </div>
                <p class="hero__note">{% t "home.hero.note" %}</p>
                <a href="{% url "trainers" %}" class="hero__switch-link">{% t "home.hero.switch_link" %}</a>
            </div>
            <div class="hero__media">
                <figure class="phone phone--tilt-l">
                    <div class="phone__screen">
                        <span class="phone__tag">{% t "home.hero.tag" %}</span>
                        <figcaption class="phone__caption">{% t "home.hero.caption_2" %}
                        </figcaption>
                        <span class="phone__needs">{% t "home.hero.needs_2" %}</span>
                    </div>
                </figure>
            </div>
        </div>
        <div class="proof-bar">
            <div class="proof-bar__grid">
                <div class="proof-stat">
                    <p class="proof-stat__value">{% t "home.hero.value" %}</p>
                    <p class="proof-stat__label">{% t "home.hero.label" %}</p>
                    <span class="tag tag--sample">{% t "home.hero.tag_2" %}</span>
                </div>
                <div class="proof-stat">
                    <p class="proof-stat__value">{% t "home.hero.value_2" %}</p>
                    <p class="proof-stat__label">{% t "home.hero.label_2" %}</p>
                    <span class="tag tag--sample">{% t "home.hero.tag_3" %}</span>
                </div>
                <div class="proof-stat">
                    <p class="proof-stat__value">{% t "home.hero.value_3" %}</p>
                    <p class="proof-stat__label">{% t "home.hero.label_3" %}</p>
                    <span class="tag tag--sample">{% t "home.hero.tag_4" %}</span>
                </div>
                <div class="proof-stat">
                    <p class="proof-stat__value">{% t "home.hero.value_4" %}</p>
                    <p class="proof-stat__label">{% t "home.hero.label_4" %}</p>
                    <span class="tag tag--sample">{% t "home.hero.tag_5" %}</span>
                </div>
            </div>
        </div>
    </section>
    <section id="dlaczego" class="section">
        <div class="container" style="display:flex;flex-direction:column;gap:40px;">
            <h2 class="h2">{% t "home.dlaczego.h2" %}</h2>
            <div class="compare-grid">
                <div class="compare-card compare-card--without">
                    <p class="compare-card__title">{% t "home.dlaczego.title" %}</p>
                    <ul>
                        <li>{% t "home.dlaczego.li" %}</li>
                        <li>{% t "home.dlaczego.li_2" %}</li>
                        <li>{% t "home.dlaczego.li_3" %}</li>
                    </ul>
                </div>
                <div class="compare-card compare-card--with">
                    <p class="compare-card__title">{% t "home.dlaczego.title_2" %}</p>
                    <ul>
                        <li>{% t "home.dlaczego.li_4" %}</li>
                        <li>{% t "home.dlaczego.li_5" %}</li>
                        <li>{% t "home.dlaczego.li_6" %}</li>
                    </ul>
                </div>
            </div>
            <p class="needs-block">{% t "home.dlaczego.needs_block" %}</p>
        </div>
    </section>
    <section id="kroki" class="section section-alt">
        <div class="container">
            <div class="intro">
                <h2 class="h2">{% t "home.kroki.h2" %}</h2>
                <p class="lead" style="max-width:none;">{% t "home.kroki.lead" %}</p>
            </div>
            <div class="step-card-grid">
                <div class="step-card">
                    <p class="step-card__label">{% t "home.kroki.label" %}</p>
                    <h3>{% t "home.kroki.h3" %}</h3>
                    <p>{% t "home.kroki.p" %}</p>
                </div>
                <div class="step-card">
                    <p class="step-card__label">{% t "home.kroki.label_2" %}</p>
                    <h3>{% t "home.kroki.h3_2" %}</h3>
                    <p>{% t "home.kroki.p_2" %}</p>
                </div>
                <div class="step-card">
                    <p class="step-card__label">{% t "home.kroki.label_3" %}</p>
                    <h3>{% t "home.kroki.h3_3" %}</h3>
                    <p>{% t "home.kroki.p_3" %}</p>
                </div>
            </div>
            <a href="{% url "find" %}" class="btn btn-outline">{% t "home.kroki.btn" %}</a>
        </div>
    </section>
    <section id="kategorie" class="section">
        <div class="container">
            <div class="intro">
                <h2 class="h2">{% t "home.kategorie.h2" %}</h2>
                <p class="lead" style="max-width:none;">{% t "home.kategorie.lead" %}</p>
            </div>
            <div class="category-grid">
                <div class="category-card">
                    <span class="category-card__icon" aria-hidden="true"></span>
                    <p class="name">{% t "home.kategorie.name" %}</p>
                    <p class="needs">{% t "home.kategorie.needs" %}</p>
                </div>
                <div class="category-card">
                    <span class="category-card__icon" aria-hidden="true"></span>
                    <p class="name">{% t "home.kategorie.name_2" %}</p>
                    <p class="needs">{% t "home.kategorie.needs_2" %}</p>
                </div>
                <div class="category-card">
                    <span class="category-card__icon" aria-hidden="true"></span>
                    <p class="name">{% t "home.kategorie.name_3" %}</p>
                    <p class="needs">{% t "home.kategorie.needs_3" %}</p>
                </div>
                <div class="category-card">
                    <span class="category-card__icon" aria-hidden="true"></span>
                    <p class="name">{% t "home.kategorie.name_4" %}</p>
                    <p class="needs">{% t "home.kategorie.needs_4" %}</p>
                </div>
                <div class="category-card">
                    <span class="category-card__icon" aria-hidden="true"></span>
                    <p class="name">{% t "home.kategorie.name_5" %}</p>
                    <p class="needs">{% t "home.kategorie.needs_5" %}</p>
                </div>
                <div class="category-card category-card--more">
                    <p class="name">{% t "home.kategorie.name_6" %}</p>
                    <span class="tag tag--sample">{% t "home.kategorie.tag" %}</span>
                </div>
            </div>
            <p class="needs-block">{% t "home.kategorie.needs_block" %}</p>
        </div>
    </section>
    <section id="gdzie" class="section section-alt">
        <div class="container">
            <div class="intro">
                <h2 class="h2" style="max-width:none;">{% t "home.gdzie.h2" %}</h2>
                <p class="lead" style="max-width:none;">{% t "home.gdzie.lead" %}</p>
            </div>
            <div class="feature-card">
                <p class="kicker">{% t "home.gdzie.kicker" %}</p>
                <h3>{% t "home.gdzie.h3" %}</h3>
                <p>{% t "home.gdzie.p" %}</p>
            </div>
            <div class="feature-card">
                <p class="kicker">{% t "home.gdzie.kicker_2" %}</p>
                <h3>{% t "home.gdzie.h3_2" %}</h3>
                <p>{% t "home.gdzie.p_2" %}</p>
            </div>
            <div class="feature-card">
                <p class="kicker">{% t "home.gdzie.kicker_3" %}</p>
                <h3>{% t "home.gdzie.h3_3" %}</h3>
                <p>{% t "home.gdzie.p_3" %}</p>
            </div>
        </div>
    </section>
    <section id="wydarzenia" class="section step-section">
        <div class="container">
            <div class="step-section__copy">
                <p class="eyebrow">{% t "home.wydarzenia.eyebrow" %}</p>
                <h2 class="h2">{% t "home.wydarzenia.h2" %}</h2>
                <p class="lead">{% t "home.wydarzenia.lead" %}</p>
                <ul class="step-list">
                    <li>{% t "home.wydarzenia.li" %}</li>
                    <li>{% t "home.wydarzenia.li_2" %}</li>
                    <li>{% t "home.wydarzenia.li_3" %}</li>
                    <li>{% t "home.wydarzenia.li_4" %}</li>
                </ul>
                <p class="step-note">{% t "home.wydarzenia.step_note" %}</p>
            </div>
            <div class="hero__media">
                <figure class="phone">
                    <div class="phone__screen">
                        <span class="phone__tag">{% t "home.wydarzenia.tag" %}</span>
                        <figcaption class="phone__caption">{% t "home.wydarzenia.caption" %}
                        </figcaption>
                        <span class="phone__needs">{% t "home.wydarzenia.needs" %}</span>
                    </div>
                </figure>
            </div>
        </div>
    </section>
    <section id="opinie" class="section section-alt">
        <div class="container">
            <div class="intro">
                <p class="eyebrow">{% t "home.opinie.eyebrow" %}</p>
                <h2 class="h2">{% t "home.opinie.h2" %}</h2>
                <p class="lead" style="max-width:none;">{% t "home.opinie.lead" %}</p>
            </div>
            <p class="needs-block">{% t "home.opinie.needs_block" %}</p>
            <div class="testimonial-grid">
                <figure class="testimonial-card">
                    <p class="testimonial-card__stars" aria-hidden="true">{% t "home.opinie.stars" %}</p>
                    <blockquote class="testimonial-card__lines">
                        <span class="testimonial-card__line" aria-hidden="true"></span><span class="testimonial-card__line" aria-hidden="true"></span><span class="testimonial-card__line testimonial-card__line--short" aria-hidden="true"></span>
                    </blockquote>
                    <figcaption class="testimonial-card__who">{% t "home.opinie.who" %}</figcaption>
                </figure>
                <figure class="testimonial-card">
                    <p class="testimonial-card__stars" aria-hidden="true">{% t "home.opinie.stars_2" %}</p>
                    <blockquote class="testimonial-card__lines">
                        <span class="testimonial-card__line" aria-hidden="true"></span><span class="testimonial-card__line" aria-hidden="true"></span><span class="testimonial-card__line testimonial-card__line--short" aria-hidden="true"></span>
                    </blockquote>
                    <figcaption class="testimonial-card__who">{% t "home.opinie.who_2" %}</figcaption>
                </figure>
                <figure class="testimonial-card">
                    <p class="testimonial-card__stars" aria-hidden="true">{% t "home.opinie.stars_3" %}</p>
                    <blockquote class="testimonial-card__lines">
                        <span class="testimonial-card__line" aria-hidden="true"></span><span class="testimonial-card__line" aria-hidden="true"></span><span class="testimonial-card__line testimonial-card__line--short" aria-hidden="true"></span>
                    </blockquote>
                    <figcaption class="testimonial-card__who">{% t "home.opinie.who_3" %}</figcaption>
                </figure>
            </div>
            <div class="testimonial-rating">
                <p class="testimonial-rating__value">{% t "home.opinie.value" %}</p>
                <p class="testimonial-rating__label">{% t "home.opinie.label" %}</p>
                <span class="tag tag--sample">{% t "home.opinie.tag" %}</span>
            </div>
        </div>
    </section>
    <section id="jezyki">
        <div class="container">
            <div class="intro">
                <h2>{% t "home.jezyki.h2" %}</h2>
                <p class="lead">{% t "home.jezyki.lead" %}</p>
            </div>
            <div class="lang-grid">
                <div class="lang-chip">
                    <p class="lang-chip__code">{% t "home.jezyki.code" %}</p>
                    <p class="lang-chip__name">{% t "home.jezyki.name" %}</p>
                </div>
                <div class="lang-chip">
                    <p class="lang-chip__code">{% t "home.jezyki.code_2" %}</p>
                    <p class="lang-chip__name">{% t "home.jezyki.name_2" %}</p>
                </div>
                <div class="lang-chip">
                    <p class="lang-chip__code">{% t "home.jezyki.code_3" %}</p>
                    <p class="lang-chip__name">{% t "home.jezyki.name_3" %}</p>
                </div>
            </div>
        </div>
    </section>
    <section id="sciezki" class="section">
        <div class="container">
            <div class="intro">
                <h2 class="h2">{% t "home.sciezki.h2" %}</h2>
                <p class="lead" style="max-width:none;">{% t "home.sciezki.lead" %}</p>
            </div>
            <div class="path-grid">
                <div class="path-card path-card--client">
                    <p class="path-card__label">{% t "home.sciezki.label" %}</p>
                    <h3>{% t "home.sciezki.h3" %}</h3>
                    <ul>
                        <li>{% t "home.sciezki.li" %}</li>
                        <li>{% t "home.sciezki.li_2" %}</li>
                        <li>{% t "home.sciezki.li_3" %}</li>
                    </ul>
                    <a href="{% url "find" %}" class="btn-ghost-link">{% t "home.sciezki.btn_ghost_link" %}</a>
                </div>
                <div class="path-card path-card--trainer">
                    <p class="path-card__label">{% t "home.sciezki.label_2" %}</p>
                    <h3>{% t "home.sciezki.h3_2" %}</h3>
                    <ul>
                        <li>{% t "home.sciezki.li_4" %}</li>
                        <li>{% t "home.sciezki.li_5" %}</li>
                        <li>{% t "home.sciezki.li_6" %}</li>
                    </ul>
                    <div class="path-card__actions">
                        <a href="{% url "trainers" %}" class="btn btn-primary">{% t "home.sciezki.btn" %}</a>
                        <a href="{% url "pricing" %}" class="btn-ghost-link">{% t "home.sciezki.btn_ghost_link_2" %}</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section id="pobierz" class="cta-banner">
        <div class="container">
            <h2>{% t "home.pobierz.h2" %}</h2>
            <p>{% t "home.pobierz.p" %}</p>
            <div class="hero__cta-row">
                <span class="btn btn-lg btn-on-red">{% t "home.pobierz.btn" %}</span>
                <div class="store-badges">
                    <img src="{% asset "assets/google-play.png" %}" alt="{% ta "home.pobierz.img_alt" %}" title="{% ta "home.pobierz.img_title" %}" />
                    <img src="{% asset "assets/app-store.svg" %}" alt="{% ta "home.pobierz.img_alt_2" %}" title="{% ta "home.pobierz.img_title_2" %}" />
                </div>
                <div class="qr-mock">
                    <span class="qr-mock__box" aria-hidden="true"></span>
                    <span class="qr-mock__caption">{% t "home.pobierz.caption" %}</span>
                </div>
            </div>
            <div class="hero__cta-row" style="margin-top:4px;">
                <p class="hero__note" style="color:rgba(255,255,255,.85);">{% t "home.pobierz.note" %}</p>
                <a href="{% url "faq" %}" class="hero__switch-link">{% t "home.pobierz.switch_link" %}</a>
            </div>
        </div>
    </section>
</main>
