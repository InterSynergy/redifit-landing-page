---
pageKey: find
css: [find]
---
{# Szukam trenera (dawniej „Jak to działa”). Numery #N = punkty z uwag klienta, docs/landing-zadania.md #}
<main>
    {# #42 #}
    <section class="page-hero">
        <div class="container">
            <p class="page-hero__eyebrow">{% t "find.hero.eyebrow" %}</p>
            <h1>{% t "find.hero.h1" %}</h1>
            <p class="lead">{% t "find.hero.lead" %}</p>
            <nav aria-label="{% ta 'find.hero.tabs_label' %}" class="pill-tabs">
                {%- for id in ['znajdz', 'sprawdz', 'zarezerwuj'] %}
                <a href="#{{ id }}">{% t "find.hero.tab_" + loop.index %}</a>
                {%- endfor %}
            </nav>
        </div>
    </section>

    {# #43 #}
    <section id="znajdz" class="section step-section">
        <div class="container">
            <div class="step-section__copy">
                <p class="eyebrow">{% t "find.znajdz.eyebrow" %}</p>
                <h2 class="h2">{% t "find.znajdz.h2" %}</h2>
                <p class="lead">{% t "find.znajdz.lead" %}</p>
                <ul class="step-list">
                    {%- for key in ['today', 'nearby', 'filters', 'favs'] %}
                    <li><span><strong>{% t "find.znajdz." + key + "_title" %}</strong> – {% t "find.znajdz." + key + "_text" %}</span></li>
                    {%- endfor %}
                </ul>
            </div>
            <div class="phone-row">
                <figure class="phone phone--sm">
                    <div class="phone__screen phone__screen--shot">
                        <img src="{% asset "assets/screens/H1_" + lang.code + ".webp" %}" alt="{% ta "find.znajdz.screen_1" %}" width="720" height="1473" loading="lazy" decoding="async">
                    </div>
                </figure>
                <figure class="phone phone--sm phone--raised">
                    <div class="phone__screen phone__screen--shot">
                        <img src="{% asset "assets/screens/F2_" + lang.code + ".webp" %}" alt="{% ta "find.znajdz.screen_2" %}" width="720" height="1473" loading="lazy" decoding="async">
                    </div>
                </figure>
            </div>
        </div>
    </section>

    {# #44 #}
    <section id="sprawdz" class="section step-section section-alt">
        <div class="container">
            <div class="hero__media">
                <figure class="phone">
                    <div class="phone__screen phone__screen--shot">
                        <img src="{% asset "assets/screens/F3_" + lang.code + ".webp" %}" alt="{% ta "find.sprawdz.screen" %}" width="720" height="1473" loading="lazy" decoding="async">
                    </div>
                </figure>
            </div>
            <div class="step-section__copy">
                <p class="eyebrow">{% t "find.sprawdz.eyebrow" %}</p>
                <h2 class="h2">{% t "find.sprawdz.h2" %}</h2>
                <p class="lead">{% t "find.sprawdz.lead" %}</p>
                <ul class="step-list">
                    {%- for key in ['bio', 'portfolio', 'reviews', 'services'] %}
                    <li><span><strong>{% t "find.sprawdz." + key + "_title" %}</strong> – {% t "find.sprawdz." + key + "_text" %}</span></li>
                    {%- endfor %}
                </ul>
                <p class="find-note">{% t "find.sprawdz.note" %}</p>
            </div>
        </div>
    </section>

    {# #45 #}
    <section id="zarezerwuj" class="section step-section">
        <div class="container">
            <div class="step-section__copy">
                <p class="eyebrow">{% t "find.zarezerwuj.eyebrow" %}</p>
                <h2 class="h2">{% t "find.zarezerwuj.h2" %}</h2>
                <p class="lead">{% t "find.zarezerwuj.lead" %}</p>
                <ul class="step-list">
                    {%- for key in ['online', 'cash', 'bookings', 'rebook', 'calendar', 'notifications'] %}
                    <li><span><strong>{% t "find.zarezerwuj." + key + "_title" %}</strong> – {% t "find.zarezerwuj." + key + "_text" %}</span></li>
                    {%- endfor %}
                </ul>
                {# #46: link do FAQ przeniesiony pod krok 3 #}
                <a href="{% url "faq" %}" class="btn-ghost-link">{% t "find.zarezerwuj.faq_link" %}</a>
            </div>
            <div class="phone-row">
                <figure class="phone phone--sm">
                    <div class="phone__screen phone__screen--shot">
                        <img src="{% asset "assets/screens/F4_" + lang.code + ".webp" %}" alt="{% ta "find.zarezerwuj.screen_1" %}" width="720" height="1473" loading="lazy" decoding="async">
                    </div>
                </figure>
                <figure class="phone phone--sm phone--raised">
                    <div class="phone__screen phone__screen--shot">
                        <img src="{% asset "assets/screens/F5_" + lang.code + ".webp" %}" alt="{% ta "find.zarezerwuj.screen_2" %}" width="720" height="1473" loading="lazy" decoding="async">
                    </div>
                </figure>
            </div>
        </div>
    </section>

    {# #46: zastępuje dawną sekcję „Bezpieczeństwo” #}
    <section id="styl" class="section section-alt">
        <div class="container">
            <div class="intro">
                <h2 class="h2">{% t "find.styl.h2" %}</h2>
                <p class="lead">{% t "find.styl.lead" %}</p>
            </div>
            <div class="feature-grid feature-grid--4">
                {%- for key in ['place', 'time', 'group', 'budget'] %}
                <div class="feature-card">
                    <h3>{% t "find.styl." + key + "_title" %}</h3>
                    <p>{% t "find.styl." + key + "_text" %}</p>
                </div>
                {%- endfor %}
            </div>
        </div>
    </section>

    {# #47 #}
    <section id="pobierz" class="cta-banner">
        <div class="container">
            <h2>{% t "find.pobierz.h2" %}</h2>
            <p>{% t "find.pobierz.p" %}</p>
            <div class="hero__cta-row">
                {% include "partials/store-row.njk" %}
            </div>
        </div>
    </section>
</main>
