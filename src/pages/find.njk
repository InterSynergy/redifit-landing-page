---
pageKey: find
css: [how]
---
<main>
    <section class="page-hero">
        <div class="container">
            <p class="page-hero__eyebrow">{% t "find.page_hero.eyebrow" %}</p>
            <h1>{% t "find.page_hero.h1" %}</h1>
            <p class="lead">{% t "find.page_hero.lead" %}</p>
            <nav aria-label="{% ta "find.pill_tabs.pill_tabs_label" %}" class="pill-tabs">
                <a href="#znajdz">{% t "find.pill_tabs.a" %}</a>
                <a href="#sprawdz">{% t "find.pill_tabs.a_2" %}</a>
                <a href="#zarezerwuj">{% t "find.pill_tabs.a_3" %}</a>
                <a href="#bezpieczenstwo">{% t "find.pill_tabs.a_4" %}</a>
            </nav>
        </div>
    </section>
    <section id="znajdz" class="section step-section">
        <div class="container">
            <div class="step-section__copy">
                <p class="eyebrow">{% t "find.znajdz.eyebrow" %}</p>
                <h2 class="h2">{% t "find.znajdz.h2" %}</h2>
                <p class="lead">{% t "find.znajdz.lead" %}</p>
                <ul class="step-list">
                    <li>{% t "find.znajdz.li" %}</li>
                    <li>{% t "find.znajdz.li_2" %}</li>
                    <li>{% t "find.znajdz.li_3" %}</li>
                    <li>{% t "find.znajdz.li_4" %}</li>
                </ul>
            </div>
            <div class="phone-row">
                <figure class="phone phone--sm">
                    <div class="phone__screen">
                        <span class="phone__tag">{% t "find.znajdz.tag" %}</span>
                        <figcaption class="phone__caption">{% t "find.znajdz.caption" %}
                        </figcaption>
                        <span class="phone__needs">{% t "find.znajdz.needs" %}</span>
                    </div>
                </figure>
                <figure class="phone phone--sm phone--raised">
                    <div class="phone__screen">
                        <span class="phone__tag">{% t "find.znajdz.tag_2" %}</span>
                        <figcaption class="phone__caption">{% t "find.znajdz.caption_2" %}
                        </figcaption>
                        <span class="phone__needs">{% t "find.znajdz.needs_2" %}</span>
                    </div>
                </figure>
            </div>
        </div>
    </section>
    <section id="sprawdz" class="section step-section section-alt">
        <div class="container">
            <div style="display:flex;flex-direction:column;align-items:center;gap:20px;">
                <figure class="phone phone--md">
                    <div class="phone__screen">
                        <span class="phone__tag">{% t "find.sprawdz.tag" %}</span>
                        <figcaption class="phone__caption">{% t "find.sprawdz.caption" %}
                        </figcaption>
                        <span class="phone__needs">{% t "find.sprawdz.needs" %}</span>
                    </div>
                </figure>
                <div class="quote-slot">
                    <p class="quote-slot__label">{% t "find.sprawdz.label" %}</p>
                    <p class="quote-slot__body">{% t "find.sprawdz.body" %}</p>
                </div>
            </div>
            <div class="step-section__copy">
                <p class="eyebrow">{% t "find.sprawdz.eyebrow" %}</p>
                <h2 class="h2">{% t "find.sprawdz.h2" %}</h2>
                <p class="lead">{% t "find.sprawdz.lead" %}</p>
                <ul class="step-list">
                    <li>{% t "find.sprawdz.li" %}</li>
                    <li>{% t "find.sprawdz.li_2" %}</li>
                    <li>{% t "find.sprawdz.li_3" %}</li>
                    <li>{% t "find.sprawdz.li_4" %}</li>
                </ul>
                <p class="step-note" style="background:#fff;border:1px solid var(--color-border-2);">{% t "find.sprawdz.step_note" %}</p>
            </div>
        </div>
    </section>
    <section id="zarezerwuj" class="section step-section">
        <div class="container">
            <div class="step-section__copy">
                <p class="eyebrow">{% t "find.zarezerwuj.eyebrow" %}</p>
                <h2 class="h2">{% t "find.zarezerwuj.h2" %}</h2>
                <p class="lead">{% t "find.zarezerwuj.lead" %}</p>
                <ul class="step-list">
                    <li>{% t "find.zarezerwuj.li" %}</li>
                    <li>{% t "find.zarezerwuj.li_2" %}</li>
                    <li>{% t "find.zarezerwuj.li_3" %}</li>
                    <li>{% t "find.zarezerwuj.li_4" %}</li>
                    <li>{% t "find.zarezerwuj.li_5" %}</li>
                </ul>
                <div class="rules-box">
                    <p class="rules-box__title">{% t "find.zarezerwuj.title" %}</p>
                    <p class="rules-box__text">{% t "find.zarezerwuj.text" %}</p>
                </div>
            </div>
            <div class="phone-row">
                <figure class="phone phone--sm">
                    <div class="phone__screen">
                        <span class="phone__tag">{% t "find.zarezerwuj.tag" %}</span>
                        <figcaption class="phone__caption">{% t "find.zarezerwuj.caption" %}
                        </figcaption>
                        <span class="phone__needs">{% t "find.zarezerwuj.needs" %}</span>
                    </div>
                </figure>
                <figure class="phone phone--sm phone--raised">
                    <div class="phone__screen">
                        <span class="phone__tag">{% t "find.zarezerwuj.tag_2" %}</span>
                        <figcaption class="phone__caption">{% t "find.zarezerwuj.caption_2" %}
                        </figcaption>
                        <span class="phone__needs">{% t "find.zarezerwuj.needs_2" %}</span>
                    </div>
                </figure>
            </div>
        </div>
    </section>
    <section id="bezpieczenstwo" class="section section-alt">
        <div class="container">
            <div class="intro">
                <h2 class="h2">{% t "find.bezpieczenstwo.h2" %}</h2>
                <p class="lead">{% t "find.bezpieczenstwo.lead" %}</p>
            </div>
            <div class="feature-grid">
                <div class="feature-card">
                    <h3>{% t "find.bezpieczenstwo.h3" %}</h3>
                    <p>{% t "find.bezpieczenstwo.p" %}</p>
                </div>
                <div class="feature-card">
                    <h3>{% t "find.bezpieczenstwo.h3_2" %}</h3>
                    <p>{% t "find.bezpieczenstwo.p_2" %}</p>
                </div>
                <div class="feature-card">
                    <h3>{% t "find.bezpieczenstwo.h3_3" %}</h3>
                    <p>{% t "find.bezpieczenstwo.p_3" %}</p>
                </div>
                <div class="feature-card">
                    <h3>{% t "find.bezpieczenstwo.h3_4" %}</h3>
                    <p>{% t "find.bezpieczenstwo.p_4" %}</p>
                </div>
                <div class="feature-card">
                    <h3>{% t "find.bezpieczenstwo.h3_5" %}</h3>
                    <p>{% t "find.bezpieczenstwo.p_5" %}</p>
                </div>
            </div>
            <div class="foot">
                <a href="#pobierz" class="btn btn-primary">{% t "find.bezpieczenstwo.btn" %}</a>
                <a href="{% url "faq" %}" class="btn-ghost-link">{% t "find.bezpieczenstwo.btn_ghost_link" %}</a>
            </div>
        </div>
    </section>
    <section id="pobierz" class="cta-banner" style="padding:64px 24px;">
        <div class="container">
            <h2 style="font-size:clamp(22px,2.8vw,32px);">{% t "find.pobierz.h2" %}</h2>
            <p>{% t "find.pobierz.p" %}</p>
            <div class="hero__cta-row">
                <span class="btn btn-lg btn-on-red">{% t "find.pobierz.btn" %}</span>
                <div class="store-badges">
                    <img src="{% asset "assets/google-play.png" %}" alt="{% ta "find.pobierz.img_alt" %}" title="{% ta "find.pobierz.img_title" %}" />
                    <img src="{% asset "assets/app-store.svg" %}" alt="{% ta "find.pobierz.img_alt_2" %}" title="{% ta "find.pobierz.img_title_2" %}" />
                </div>
            </div>
        </div>
    </section>
</main>
