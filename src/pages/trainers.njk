---
pageKey: trainers
css: [trainers]
---
{# Dla trenerów. Numery #N = punkty z uwag klienta, docs/landing-zadania.md #}
<main>
    {# #30–#32 #}
    <section id="t-hero" class="hero">
        <div class="hero__pattern" aria-hidden="true"></div>
        <div class="hero__grid">
            <div class="hero__copy">
                <div class="role-toggle">
                    <a href="{% url "home" %}">{% t "trainers.hero.role_client" %}</a>
                    <span aria-current="page">{% t "trainers.hero.role_trainer" %}</span>
                </div>
                <p class="hero__eyebrow">{% t "trainers.hero.eyebrow" %}</p>
                <h1 class="h1">{% t "trainers.hero.h1" %}</h1>
                <p class="hero__sub">{% t "trainers.hero.sub" %}</p>
                <div class="hero__cta-row">
                    <a href="#pobierz" class="btn btn-lg btn-primary">{% t "trainers.hero.try_free" %}</a>
                </div>
                <div class="hero__cta-row">
                    {% include "partials/store-row.njk" %}
                </div>
                <p class="hero__free">{% t "trainers.hero.trial" %}</p>
                {# #32: statystyki ukryte do czasu realnych danych — site.json → features.stats #}
                {% if site.features.stats %}
                <div class="hero-proof">
                    {%- for key in ['trainers', 'bookings'] %}
                    <div class="hero-proof__item">
                        <p class="hero-proof__value">{% t "trainers.hero.stats." + key + "_value" %}</p>
                        <p class="hero-proof__label">{% t "trainers.hero.stats." + key + "_label" %}</p>
                    </div>
                    {%- endfor %}
                </div>
                {% endif %}
            </div>
            <div class="hero__media">
                {# #31: screen kalendarza trenera z listą treningów na wybrany dzień #}
                <figure class="phone phone--tilt-r">
                    <div class="phone__screen">
                        <figcaption class="phone__caption">{% t "trainers.hero.screen_caption" %}</figcaption>
                    </div>
                </figure>
            </div>
        </div>
    </section>

    {# #33 #}
    <section id="t-dlaczego" class="section">
        <div class="container">
            <h2 class="h2">{% t "trainers.dlaczego.h2" %}</h2>
            <div class="compare-grid compare-grid--lg">
                <div class="compare-card compare-card--without">
                    <p class="compare-card__title">{% t "trainers.dlaczego.without_title" %}</p>
                    <ul>
                        {%- for i in range(1, 6) %}
                        <li><span>{% t "trainers.dlaczego.without_" + i %}</span></li>
                        {%- endfor %}
                    </ul>
                </div>
                <div class="compare-card compare-card--with">
                    <p class="compare-card__title">{% t "trainers.dlaczego.with_title" %}</p>
                    <ul>
                        {%- for i in range(1, 6) %}
                        <li><span>{% t "trainers.dlaczego.with_" + i %}</span></li>
                        {%- endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </section>

    {# #34 #}
    <section id="t-profil" class="section section-alt step-section">
        <div class="container">
            <div class="step-section__copy">
                <h2 class="h2">{% t "trainers.profil.h2" %}</h2>
                <p class="lead">{% t "trainers.profil.lead" %}</p>
                <ul class="step-list">
                    {%- for key in ['bio', 'portfolio', 'reviews', 'visibility', 'events'] %}
                    <li><span><strong>{% t "trainers.profil." + key + "_title" %}</strong> – {% t "trainers.profil." + key + "_text" %}</span></li>
                    {%- endfor %}
                </ul>
            </div>
            <div class="hero__media">
                <figure class="phone">
                    <div class="phone__screen">
                        <figcaption class="phone__caption">{% t "trainers.profil.screen_caption" %}</figcaption>
                    </div>
                </figure>
            </div>
        </div>
    </section>

    {# #35 #}
    <section id="t-zasady" class="section">
        <div class="container">
            <h2 class="h2">{% t "trainers.zasady.h2" %}</h2>
            <div class="feature-grid feature-grid--4">
                {%- for key in ['services', 'place', 'availability', 'rules', 'timeoff', 'happy', 'payments', 'events'] %}
                <div class="feature-card feature-card--muted">
                    <h3>{% t "trainers.zasady." + key + "_title" %}</h3>
                    <p>{% t "trainers.zasady." + key + "_text" %}</p>
                </div>
                {%- endfor %}
            </div>
        </div>
    </section>

    {# #36 #}
    <section id="t-popyt" class="section section-alt">
        <div class="container">
            <div class="intro">
                <p class="eyebrow">{% t "trainers.popyt.eyebrow" %}</p>
                <h2 class="h2">{% t "trainers.popyt.h2" %}</h2>
                <p class="lead">{% t "trainers.popyt.lead" %}</p>
            </div>
            <div class="feature-grid feature-grid--4">
                {%- for key in ['happy', 'group', 'sms', 'rebook'] %}
                <div class="feature-card">
                    <h3>{% t "trainers.popyt." + key + "_title" %}</h3>
                    <p>{% t "trainers.popyt." + key + "_text" %}</p>
                </div>
                {%- endfor %}
            </div>
        </div>
    </section>

    {# #37 #}
    <section id="t-praca" class="section step-section">
        <div class="container">
            <div class="phone-row">
                <figure class="phone phone--sm">
                    <div class="phone__screen">
                        <figcaption class="phone__caption">{% t "trainers.praca.screen_1" %}</figcaption>
                    </div>
                </figure>
                <figure class="phone phone--sm phone--raised">
                    <div class="phone__screen">
                        <figcaption class="phone__caption">{% t "trainers.praca.screen_2" %}</figcaption>
                    </div>
                </figure>
            </div>
            <div class="step-section__copy">
                <h2 class="h2">{% t "trainers.praca.h2" %}</h2>
                <ul class="step-list">
                    {%- for key in ['calendar', 'bookings', 'clients', 'sms'] %}
                    <li><span><strong>{% t "trainers.praca." + key + "_title" %}</strong> – {% t "trainers.praca." + key + "_text" %}</span></li>
                    {%- endfor %}
                </ul>
            </div>
        </div>
    </section>

    {# #38 #}
    <section id="t-platnosci" class="section section-alt step-section">
        <div class="container">
            <div class="step-section__copy">
                <h2 class="h2">{% t "trainers.platnosci.h2" %}</h2>
                <ul class="step-list">
                    {%- for key in ['methods', 'online', 'stats', 'history'] %}
                    <li><span><strong>{% t "trainers.platnosci." + key + "_title" %}</strong> – {% t "trainers.platnosci." + key + "_text" %}</span></li>
                    {%- endfor %}
                </ul>
            </div>
            <div class="phone-row">
                <figure class="phone phone--sm">
                    <div class="phone__screen">
                        <figcaption class="phone__caption">{% t "trainers.platnosci.screen_1" %}</figcaption>
                    </div>
                </figure>
                <figure class="phone phone--sm phone--raised">
                    <div class="phone__screen">
                        <figcaption class="phone__caption">{% t "trainers.platnosci.screen_2" %}</figcaption>
                    </div>
                </figure>
            </div>
        </div>
    </section>

    {# #39 #}
    <section id="t-start" class="section">
        <div class="container">
            <h2 class="h2">{% t "trainers.start.h2" %}</h2>
            <ol class="start-steps">
                {%- for i in range(1, 5) %}
                <li>
                    <span class="start-steps__num" aria-hidden="true">{{ i }}</span>
                    <p>{% t "trainers.start.step_" + i %}</p>
                </li>
                {%- endfor %}
            </ol>
            <p class="start-free">{% t "trainers.start.free" %}</p>
            <a href="{% url "pricing" %}" class="btn-ghost-link">{% t "trainers.start.pricing_link" %}</a>
        </div>
    </section>

    {# #40 #}
    <section id="pobierz" class="cta-banner">
        <div class="container">
            <h2>{% t "trainers.pobierz.h2" %}</h2>
            <p>{% t "trainers.pobierz.p" %}</p>
            <span class="btn btn-lg btn-on-red">{% t "trainers.pobierz.try_free" %}</span>
            <div class="hero__cta-row">
                {% include "partials/store-row.njk" %}
            </div>
        </div>
    </section>
</main>
