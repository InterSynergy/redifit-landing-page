---
pageKey: contact
css: [contact]
---
{# Kontakt. Numery #N = punkty z uwag klienta, docs/landing-zadania.md.
   Układ wg docs/wzory/59-kontakt-uklad.png. E-mail i telefon: site.json → contact.
   Formularz na razie nic nie wysyła (decyzja z 2026-11-23) — walidacja i komunikat w script.js. #}
{% set icon = {
    "mail": '<path d="M3 6.5h18v11H3z"/><path d="m3.5 7 8.5 6.5L20.5 7"/>',
    "phone": '<path d="M6.6 3.5 9.4 7l-1.8 2.3a12 12 0 0 0 7.1 7.1L17 14.6l3.5 2.8-1.3 3a2 2 0 0 1-2.1 1.1C10.4 20.6 3.4 13.6 2.5 6.9a2 2 0 0 1 1.1-2.1z"/>',
    "pin": '<path d="M12 21s-6.5-6.1-6.5-11a6.5 6.5 0 0 1 13 0c0 4.9-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>',
    "calendar": '<rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>'
} %}
{% macro svg(paths) %}<svg class="contact-icon" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">{{ paths | safe }}</svg>{% endmacro %}
<main>
    {# #58 #}
    <section class="page-hero">
        <div class="container">
            <p class="page-hero__eyebrow">{% t "contact.hero.eyebrow" %}</p>
            <h1>{% t "contact.hero.h1" %}</h1>
            <p class="lead">{% t "contact.hero.lead" %}</p>
        </div>
    </section>

    {# #59, #60 #}
    <section class="contact-page-section">
        <div class="contact-page-grid">
            <div class="contact-card">
                <div class="contact-card__head">
                    {{ svg(icon.mail) }}
                    <div>
                        <h2>{% t "contact.form.title" %}</h2>
                        <p class="contact-card__sub">{% t "contact.form.sub" %}</p>
                    </div>
                </div>
                <div class="form-success" id="k-success" data-mock-form-success="k" hidden role="status">
                    <p>{% t "contact.form.success_title" %}</p>
                    <p>{% t "contact.form.success_text" %}</p>
                    <button type="button" class="btn btn-outline" data-mock-form-reset>{% t "contact.form.success_again" %}</button>
                </div>
                <form id="k" data-mock-form="k" novalidate>
                    <div class="form-row">
                        <div class="form-field">
                            <label for="k-name">{% t "contact.form.name" %} <span class="req" aria-hidden="true">*</span></label>
                            <input id="k-name" name="name" type="text" required minlength="2" autocomplete="name" placeholder="{% ta 'contact.form.name_ph' %}"/>
                            <p class="form-field__error" id="k-name-error" hidden>{% t "contact.form.required" %}</p>
                        </div>
                        <div class="form-field">
                            <label for="k-email">{% t "contact.form.email" %} <span class="req" aria-hidden="true">*</span></label>
                            <input id="k-email" name="email" type="email" required autocomplete="email" placeholder="{% ta 'contact.form.email_ph' %}"/>
                            <p class="form-field__error" id="k-email-error" hidden>{% t "contact.form.email_invalid" %}</p>
                        </div>
                    </div>
                    <div class="form-field">
                        <label for="k-role">{% t "contact.form.role" %} <span class="req" aria-hidden="true">*</span></label>
                        <select id="k-role" name="role" required>
                            <option value="" selected disabled>{% t "contact.form.role_ph" %}</option>
                            <option value="klient">{% t "contact.form.role_client" %}</option>
                            <option value="trener">{% t "contact.form.role_trainer" %}</option>
                            <option value="inne">{% t "contact.form.role_other" %}</option>
                        </select>
                        <p class="form-field__error" id="k-role-error" hidden>{% t "contact.form.required" %}</p>
                    </div>
                    <div class="form-field">
                        <label for="k-subject">{% t "contact.form.subject" %} <span class="req" aria-hidden="true">*</span></label>
                        <input id="k-subject" name="subject" type="text" required placeholder="{% ta 'contact.form.subject_ph' %}"/>
                        <p class="form-field__error" id="k-subject-error" hidden>{% t "contact.form.required" %}</p>
                    </div>
                    <div class="form-field">
                        <label for="k-message">{% t "contact.form.message" %} <span class="req" aria-hidden="true">*</span></label>
                        <textarea id="k-message" name="message" rows="5" required maxlength="2000" placeholder="{% ta 'contact.form.message_ph' %}"></textarea>
                        <p class="form-field__error" id="k-message-error" hidden>{% t "contact.form.required" %}</p>
                    </div>
                    <div class="consent-list">
                        <label class="consent-label">
                            <input type="checkbox" data-consent required/>
                            <span>{% t "contact.form.consent" %} <span class="req" aria-hidden="true">*</span></span>
                        </label>
                        <p class="form-field__error" data-consent-error hidden>{% t "contact.form.consent_error" %}</p>
                    </div>
                    <button type="submit" class="btn btn-primary contact-card__submit">{% t "contact.form.submit" %}</button>
                </form>
            </div>

            <div class="contact-side">
                <div class="contact-info-card">
                    <div class="contact-card__head">
                        {{ svg(icon.phone) }}
                        <h2>{% t "contact.info.title" %}</h2>
                    </div>
                    <dl>
                        <div>
                            {{ svg(icon.mail) }}
                            <dt>{% t "contact.info.email" %}</dt>
                            <dd><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></dd>
                        </div>
                        <div>
                            {{ svg(icon.phone) }}
                            <dt>{% t "contact.info.phone" %}</dt>
                            <dd><a href="tel:{{ site.contact.phoneHref }}">{{ site.contact.phone }}</a></dd>
                        </div>
                        <div>
                            {{ svg(icon.pin) }}
                            <dt>{% t "contact.info.address" %}</dt>
                            <dd>{% t "contact.info.address_lines" %}</dd>
                        </div>
                    </dl>
                </div>
                <div class="contact-note-card">
                    <div class="contact-card__head">
                        {{ svg(icon.calendar) }}
                        <h2>{% t "contact.account.title" %}</h2>
                    </div>
                    {% tp "contact.account.text" %}
                    <a href="{% url "faq" %}" class="btn btn-outline contact-note-card__btn">{% t "contact.account.faq_link" %}</a>
                </div>
            </div>
        </div>
    </section>

    <section id="pobierz" class="cta-banner">
        <div class="container">
            <h2>{% t "contact.pobierz.h2" %}</h2>
            <p>{% t "contact.pobierz.p" %}</p>
            <div class="hero__cta-row">
                {% include "partials/store-row.njk" %}
            </div>
        </div>
    </section>
</main>
