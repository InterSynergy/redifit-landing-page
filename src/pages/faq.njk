---
pageKey: faq
css: [faq]
---
{# FAQ. Numery #N = punkty z uwag klienta, docs/landing-zadania.md.
   Pytania: i18n → faq.<client|trainer>.groups.<grupa>.questions.<qN>.{q,a}.
   Nowe pytanie = nowy wpis qN w każdym języku; w odpowiedzi pusta linia = nowy akapit. #}
{% set F = i18n[lang.code].faq %}
<main>
    {# #48 #}
    <section class="page-hero">
        <div class="container">
            <p class="page-hero__eyebrow">{% t "faq.hero.eyebrow" %}</p>
            <h1>{% t "faq.hero.h1" %}</h1>
            <p class="lead">{% t "faq.hero.lead" %}</p>
            <nav aria-label="{% ta 'faq.hero.tabs_label' %}" class="pill-tabs">
                <a href="#faq-klient">{% t "faq.hero.tab_client" %}</a>
                <a href="#faq-trener">{% t "faq.hero.tab_trainer" %}</a>
            </nav>
        </div>
    </section>

    {# #49 (klient) i #50 (trener) #}
    {%- for sec in [{ "key": "client", "id": "faq-klient", "alt": false }, { "key": "trainer", "id": "faq-trener", "alt": true }] %}
    <section id="{{ sec.id }}" class="faq-page-section{% if sec.alt %} section-alt{% endif %}">
        <div class="container-faq">
            <h2>{% t "faq." + sec.key + ".title" %}</h2>
            {%- for gkey, group in F[sec.key].groups %}
            <div class="faq-group">
                <h3 class="faq-group__title">{% t "faq." + sec.key + ".groups." + gkey + ".title" %}</h3>
                <div class="faq-list">
                    {%- for qkey, item in group.questions %}
                    {%- set base = "faq." + sec.key + ".groups." + gkey + ".questions." + qkey %}
                    <details class="faq-item" data-faq id="{{ sec.id }}-{{ qkey }}">
                        <summary>{% t base + ".q" %}</summary>
                        <div class="faq-item__answer">{% tp base + ".a" %}</div>
                    </details>
                    {%- endfor %}
                </div>
            </div>
            {%- endfor %}
        </div>
    </section>
    {%- endfor %}

    {# #51 #}
    <section class="faq-more">
        <div class="container-faq">
            <h2>{% t "faq.more.h2" %}</h2>
            <p class="lead">{% t "faq.more.lead" %}</p>
            <a href="{% url "contact" %}" class="btn btn-primary">{% t "faq.more.btn" %}</a>
        </div>
    </section>

    {# #52 #}
    <section id="pobierz" class="cta-banner">
        <div class="container">
            <h2>{% t "faq.pobierz.h2" %}</h2>
            <p>{% t "faq.pobierz.p" %}</p>
            <div class="hero__cta-row">
                {% include "partials/store-row.njk" %}
            </div>
        </div>
    </section>
</main>
{% faqJsonLd "client", "trainer" %}
