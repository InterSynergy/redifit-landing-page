---
pageKey: pricing
css: [pricing]
---
{# Cennik. Numery #N = punkty z uwag klienta, docs/landing-zadania.md.
   Kwoty (abonament, prowizja) są w site.json → pricing; w tekstach wstawia je {num:…}. #}
<main>
    {# #54 #}
    <section class="page-hero">
        <div class="container">
            <p class="page-hero__eyebrow">{% t "pricing.hero.eyebrow" %}</p>
            <h1>{% t "pricing.hero.h1" %}</h1>
            <p class="lead">{% t "pricing.hero.lead" %}</p>
            <p class="hero__free">{% t "pricing.hero.free_for_clients" %}</p>
        </div>
    </section>

    {# #55 #}
    <section class="section" id="abonament">
        <div class="container">
            <div class="price-card">
                <div class="price-card__head">
                    <p class="price-card__plan">{% t "pricing.plan.label" %}</p>
                    <p class="price-card__amount">{% t "pricing.plan.amount" %} <span>{% t "pricing.plan.period" %}</span></p>
                    <p class="price-card__frame">{% t "pricing.plan.frame" %}</p>
                </div>
                <div class="price-card__body">
                    <h2 class="price-card__benefits-title">{% t "pricing.plan.benefits_title" %}</h2>
                    <ul class="benefit-grid">
                        {%- for i in range(1, 9) %}
                        <li class="benefit-tile">{% t "pricing.plan.benefit_" + i %}</li>
                        {%- endfor %}
                    </ul>
                </div>
                <div class="price-card__foot">
                    <p class="price-card__trial">{% t "pricing.plan.trial" %}</p>
                    <a href="#pobierz" class="btn btn-lg btn-primary">{% t "pricing.plan.try_free" %}</a>
                </div>
            </div>
        </div>
    </section>

    {# #56 #}
    <section class="section section-alt" id="prowizje">
        <div class="container">
            <div class="intro">
                <h2 class="h2">{% t "pricing.fees.h2" %}</h2>
                <p class="lead">{% t "pricing.fees.lead" %}</p>
            </div>
            <table class="fee-table">
                <thead>
                    <tr>
                        <th scope="col">{% t "pricing.fees.col_type" %}</th>
                        <th scope="col">{% t "pricing.fees.col_fee" %}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th scope="row">{% t "pricing.fees.online" %}</th>
                        <td>{% t "pricing.fees.online_fee" %}</td>
                    </tr>
                    <tr>
                        <th scope="row">{% t "pricing.fees.offline" %}</th>
                        <td class="fee-table__free">{% t "pricing.fees.offline_fee" %}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    {# #57 #}
    <section id="pobierz" class="cta-banner">
        <div class="container">
            <h2>{% t "pricing.pobierz.h2" %}</h2>
            <p>{% t "pricing.pobierz.p" %}</p>
            <span class="btn btn-lg btn-on-red">{% t "pricing.pobierz.try_free" %}</span>
            <div class="hero__cta-row">
                {% include "partials/store-row.njk" %}
            </div>
        </div>
    </section>
</main>
