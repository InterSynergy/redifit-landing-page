---
pageKey: pricing
css: [pricing]
---
<main>
    <section class="page-hero" style="padding:72px 24px;">
        <div class="container">
            <p class="page-hero__eyebrow">{% t "pricing.page_hero.eyebrow" %}</p>
            <h1>{% t "pricing.page_hero.h1" %}</h1>
            <p class="lead">{% t "pricing.page_hero.lead" %}</p>
        </div>
    </section>
    <section class="section">
        <div class="container">
            <div class="pricing-grid">
                <div class="price-card">
                    <div class="price-card__head">
                        <p class="price-card__plan">{% t "pricing.section.plan" %}</p>
                        <p class="price-card__amount">{% t "pricing.section.amount" %}</p>
                        <p class="price-card__frame">{% t "pricing.section.frame" %}</p>
                        <p class="needs-block" style="margin-top:4px;">{% t "pricing.section.needs_block" %}</p>
                    </div>
                    <ul class="price-card__incl">
                        <li>{% t "pricing.section.li" %}</li>
                        <li>{% t "pricing.section.li_2" %}</li>
                        <li>{% t "pricing.section.li_3" %}</li>
                        <li>{% t "pricing.section.li_4" %}</li>
                    </ul>
                    <dl class="price-card__meta">
                        <div class="price-card__meta-row">
                            <dt>{% t "pricing.section.dt" %}</dt>
                            <dd>{% t "pricing.section.dd" %}</dd>
                        </div>
                        <div class="price-card__meta-row">
                            <dt>{% t "pricing.section.dt_2" %}</dt>
                            <dd style="font:500 11px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--color-gray);">
                                {% t "pricing.section.dd_2" %}
                            </dd>
                        </div>
                        <div class="price-card__meta-row">
                            <dt>{% t "pricing.section.dt_3" %}</dt>
                            <dd>{% t "pricing.section.dd_3" %}</dd>
                        </div>
                    </dl>
                    <p class="price-card__manage">{% t "pricing.section.manage" %}</p>
                    <a href="#pobierz" class="btn btn-primary" style="align-self:flex-start;">{% t "pricing.section.btn" %}</a>
                </div>
                <div class="pricing-side">
                    <div class="pricing-info-card pricing-info-card--muted">
                        <p class="pricing-info-card__label">{% t "pricing.section.label" %}</p>
                        <h2>{% t "pricing.section.h2" %}</h2>
                        <p>{% t "pricing.section.p" %}</p>
                        <p class="needs-block">{% t "pricing.section.needs_block_2" %}</p>
                    </div>
                    <div class="pricing-info-card pricing-info-card--white">
                        <h2>{% t "pricing.section.h2_2" %}</h2>
                        <p>{% t "pricing.section.p_2" %}</p>
                        <a href="{% url "faq" %}" class="btn-ghost-link">{% t "pricing.section.btn_ghost_link" %}</a>
                    </div>
                    <div class="pricing-info-card pricing-info-card--dark">
                        <h2>{% t "pricing.section.h2_3" %}</h2>
                        <p>{% t "pricing.section.p_3" %}</p>
                        <a href="{% url "contact" %}" class="btn btn-on-red" style="align-self:flex-start;">{% t "pricing.section.btn_2" %}</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section id="pobierz" class="cta-banner" style="padding:64px 24px;">
        <div class="container">
            <h2 style="font-size:clamp(22px,2.8vw,32px);">{% t "pricing.pobierz.h2" %}</h2>
            <p>{% t "pricing.pobierz.p" %}</p>
            <div class="hero__cta-row">
                <span class="btn btn-lg btn-on-red">{% t "pricing.pobierz.btn" %}</span>
                <div class="store-badges">
                    <img src="{% asset "assets/google-play.png" %}" alt="{% ta "pricing.pobierz.img_alt" %}" title="{% ta "pricing.pobierz.img_title" %}" />
                    <img src="{% asset "assets/app-store.svg" %}" alt="{% ta "pricing.pobierz.img_alt_2" %}" title="{% ta "pricing.pobierz.img_title_2" %}" />
                </div>
            </div>
        </div>
    </section>
</main>
