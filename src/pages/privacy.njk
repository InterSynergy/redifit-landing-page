---
pageKey: privacy
---
<main class="legal-main">
    <div class="container-narrow">
        <div class="legal-header">
            <h1>{% t "privacy.main.h1" %}</h1>
            <p class="updated">{% t "privacy.main.updated" %}</p>
        </div>
        <nav aria-label="{% ta "privacy.toc.toc_label" %}" class="toc">
            <p class="toc__title">{% t "privacy.toc.title" %}</p>
            <ul>
                <li>{% t "privacy.toc.li" %}</li>
                <li>{% t "privacy.toc.li_2" %}</li>
                <li>{% t "privacy.toc.li_3" %}</li>
                <li>{% t "privacy.toc.li_4" %}</li>
                <li>{% t "privacy.toc.li_5" %}</li>
                <li>{% t "privacy.toc.li_6" %}</li>
            </ul>
        </nav>
        <div class="legal-callout">
            <p class="legal-callout__title">{% t "privacy.main.title" %}</p>
            <p>{% t "privacy.main.p" %}</p>
        </div>
        <section id="p-1" class="legal-section">
            <h2>{% t "privacy.p_1.h2" %}</h2>
            <p>{% t "privacy.p_1.p" %}</p>
        </section>
        <section id="p-2" class="legal-section">
            <h2>{% t "privacy.p_2.h2" %}</h2>
            <p>{% t "privacy.p_2.p" %}</p>
        </section>
        <section id="p-3" class="legal-section">
            <h2>{% t "privacy.p_3.h2" %}</h2>
            <p>{% t "privacy.p_3.p" %}</p>
        </section>
        <section id="p-4" class="legal-section">
            <h2>{% t "privacy.p_4.h2" %}</h2>
            <p>{% t "privacy.p_4.p" %}</p>
        </section>
        <section id="p-5" class="legal-section">
            <h2>{% t "privacy.p_5.h2" %}</h2>
            <p>{% t "privacy.p_5.p" %}</p>
        </section>
        <section id="p-6" class="legal-section">
            <h2>{% t "privacy.p_6.h2" %}</h2>
            <p>{% t "privacy.p_6.p" %}</p>
        </section>
    </div>
</main>
<section id="pobierz" class="cta-banner" style="padding:64px 24px;">
    <div class="container">
        <h2 style="font-size:clamp(22px,2.8vw,32px);">{% t "privacy.pobierz.h2" %}</h2>
        <p>{% t "privacy.pobierz.p" %}</p>
        <div class="hero__cta-row">
            <span class="btn btn-lg btn-on-red">{% t "privacy.pobierz.btn" %}</span>
            <div class="store-badges">
                <img src="{% asset "assets/google-play.png" %}" alt="{% ta "privacy.pobierz.img_alt" %}" title="{% ta "privacy.pobierz.img_title" %}" />
                <img src="{% asset "assets/app-store.svg" %}" alt="{% ta "privacy.pobierz.img_alt_2" %}" title="{% ta "privacy.pobierz.img_title_2" %}" />
            </div>
        </div>
    </div>
</section>
