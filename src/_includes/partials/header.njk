<header class="site-header">
    <div class="site-header__bar container">
        <a href="{% url 'home' %}" class="logo" aria-label="{% ta 'common.logo_label' %}">
            <img class="logo-mark" src="{% asset 'assets/logo.webp' %}" alt="Redifit"/>
        </a>
        <nav aria-label="{% ta 'common.nav_label' %}" class="main-nav">
            {%- for key in ['find', 'trainers', 'pricing', 'faq', 'contact'] %}
            <a href="{% url key %}"{% if key == pageKey %} aria-current="page"{% endif %}>{% t 'common.nav.' + key %}</a>
            {%- endfor %}
        </nav>
        {% set langMenuClass = '' %}{% include "partials/lang-menu.njk" %}
        <a href="#pobierz" class="btn btn-primary">{% t 'common.get_app' %}</a>
    </div>
</header>
