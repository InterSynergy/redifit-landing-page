<div role="region" aria-label="{% ta 'common.cookie.label' %}" class="cookie-banner" data-cookie-banner>
    <div class="container">
        <p>{% t 'common.cookie.text' %}</p>
        <div class="cookie-banner__actions">
            <button type="button" class="btn btn-primary" data-cookie-accept>{% t 'common.cookie.accept' %}</button>
            <button type="button" class="btn btn-neutral" data-cookie-accept>{% t 'common.cookie.essential' %}</button>
        </div>
    </div>
</div>
