{# Stopka wg uwagi #27; adres (#29) zostaje; przełącznik języka jako lista (#28). #}
<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-col footer-col--brand">
                <a href="{% url 'home' %}" class="logo" aria-label="{% ta 'common.logo_label' %}">
                    <img class="logo-mark" src="{% asset 'assets/logo.webp' %}" alt="REDi FIT"/>
                </a>
                <p>{% t 'common.footer.tagline' %}</p>
                <p class="footer-social">
                    {%- for s in site.social %}
                    {% if not loop.first %}<span aria-hidden="true">·</span> {% endif %}<a href="{{ s.url }}">{{ s.name }}</a>
                    {%- endfor %}
                </p>
            </div>
            <div class="footer-col">
                <p class="footer-col__title">{% t 'common.footer.col_app' %}</p>
                <a href="{% url 'find' %}">{% t 'common.footer.links.find' %}</a>
                <a href="{% url 'trainers' %}">{% t 'common.footer.links.trainers' %}</a>
                <a href="{% url 'pricing' %}">{% t 'common.footer.links.pricing' %}</a>
            </div>
            <div class="footer-col">
                <p class="footer-col__title">{% t 'common.footer.col_help' %}</p>
                <a href="{% url 'faq' %}">{% t 'common.footer.links.faq' %}</a>
                <a href="{% url 'contact' %}">{% t 'common.footer.links.contact' %}</a>
            </div>
            <div class="footer-col">
                <p class="footer-col__title">{% t 'common.footer.col_info' %}</p>
                <a href="{% url 'terms' %}">{% t 'common.footer.links.terms' %}</a>
                <a href="{% url 'privacy' %}">{% t 'common.footer.links.privacy' %}</a>
                <button type="button" class="footer-link-btn" data-cookie-settings>{% t 'common.footer.links.cookies' %}</button>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="footer-bottom__meta">
                <p>{% t 'common.footer.address' %}</p>
                <p class="footer-copy">{% t 'common.footer.copyright' %}</p>
            </div>
            {% set langMenuClass = ' lang-menu--dark lang-menu--up' %}{% include "partials/lang-menu.njk" %}
        </div>
    </div>
</footer>
