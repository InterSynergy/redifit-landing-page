<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-col footer-col--brand">
                <div class="logo" style="pointer-events:none;">
                    <img class="logo-mark" src="{% asset 'assets/logo.webp' %}" alt="Redifit"/>
                </div>
                <p>{% t 'common.footer.tagline' %}</p>
                <div class="footer-social">
                    {%- for s in site.social %}
                    <a href="{{ s.url }}">{{ s.name }}</a>
                    {%- endfor %}
                </div>
            </div>
            <div class="footer-col">
                <p class="footer-col__title">{% t 'common.footer.col_app' %}</p>
                <a href="{% url 'find' %}">{% t 'common.nav.find' %}</a>
                <a href="{% url 'trainers' %}">{% t 'common.nav.trainers' %}</a>
                <a href="{% url 'pricing' %}">{% t 'common.nav.pricing' %}</a>
            </div>
            <div class="footer-col">
                <p class="footer-col__title">{% t 'common.footer.col_help' %}</p>
                <a href="{% url 'faq' %}">{% t 'common.nav.faq' %}</a>
                <a href="{% url 'contact' %}">{% t 'common.nav.contact' %}</a>
            </div>
            <div class="footer-col">
                <p class="footer-col__title">{% t 'common.footer.col_info' %}</p>
                <a href="{% url 'terms' %}">{% t 'common.footer.terms' %}</a>
                <a href="{% url 'privacy' %}">{% t 'common.footer.privacy' %}</a>
                <a href="{% url 'notfound' %}" class="footer-link--muted">{% t 'common.footer.preview_404' %}</a>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="footer-bottom__meta">
                <p>{% t 'common.footer.address' %}</p>
                <p class="footer-copy">{% t 'common.footer.copyright' %}</p>
                <p class="tag--needs">{% t 'common.footer.needs' %}</p>
            </div>
            {% set langSwitchClass = ' lang-switch--dark' %}{% include "partials/lang-switch.njk" %}
        </div>
    </div>
</footer>
