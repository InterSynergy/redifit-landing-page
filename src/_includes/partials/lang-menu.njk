{# Przełącznik języka jako rozwijana lista (uwagi #28, #53; wzór docs/wzory/53-przelacznik-jezyka-gora.png).
   Działa bez JS (<details>); script.js zamyka go po kliknięciu obok i klawiszem Esc.
   langMenuClass: '' (nagłówek) albo ' lang-menu--dark lang-menu--up' (stopka). #}
<details class="lang-menu{{ langMenuClass }}" data-lang-menu>
    <summary class="lang-menu__toggle" aria-label="{% ta 'common.lang_label' %}: {{ lang.name }}">
        <svg class="lang-menu__globe" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></svg>
        <span class="lang-menu__code">{{ lang.label }}</span>
        <svg class="lang-menu__chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </summary>
    <ul class="lang-menu__list">
        {%- for l in languages %}
        <li><a href="{% url pageKey, l.code %}" hreflang="{{ l.code }}" lang="{{ l.code }}"{% if l.code == lang.code %} aria-current="true"{% endif %}>{{ l.name }}<span class="lang-menu__short">{{ l.label }}</span></a></li>
        {%- endfor %}
    </ul>
</details>
